import random
import numpy as np

random.seed(4)

num_tasks = 20
num_machines = 4

target_schedule = [
    0,2,1,1,3,3,3,3,0,2,
    0,2,3,0,0,0,0,2,3,1
]

processing_times = [
    2.11, 2.34, 1.77, 1.66, 2.98,
    2.45, 1.99, 2.88, 1.55, 2.40,
    1.33, 2.22, 2.90, 1.44, 1.66,
    1.55, 1.22, 2.66, 2.91, 1.88
]

def makespan(schedule):
    load = [0]*num_machines
    for i,m in enumerate(schedule):
        load[m] += processing_times[i]
    return max(load)

def mutate_towards_target(current, step):
    new = current[:]
    indices = list(range(len(current)))
    random.shuffle(indices)
    count = 0
    for idx in indices:
        if new[idx] != target_schedule[idx]:
            new[idx] = target_schedule[idx]
            count += 1
        if count >= step:
            break
    return new

grid_size = 5
grid = [[
    [random.randint(0,num_machines-1) for _ in range(num_tasks)]
    for _ in range(grid_size)
] for __ in range(grid_size)]

best = grid[0][0]
best_fit = makespan(best)

