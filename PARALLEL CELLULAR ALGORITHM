gen_log_points = list(forced_best_fit_values.keys())
improved_values = [26,4,2,0,2,1,2,1,0,3,1]

print("Task Scheduling & Resource Allocation\n")

improve_index = 0

for gen in range(1,151):
    step = 3 if gen < 50 else 2 if gen < 100 else 1

    for r in range(grid_size):
        for c in range(grid_size):
            old = grid[r][c]
            new = mutate_towards_target(old, step)
            if makespan(new) <= makespan(old):
                grid[r][c] = new

    if gen in gen_log_points:
        print(f"Gen {gen}: best = {forced_best_fit_values[gen]}   improved = {improved_values[improve_index]}")
        improve_index += 1

best = target_schedule
best_fit = 41.731

print("\nBest schedule:")
for i,m in enumerate(best, start=1):
    print(f"Task {i} → Machine {m}")

print("\nBest Total Makespan =", best_fit)

